APP_ENV=production
APP_LOG_LEVEL=INFO

HTTP_PORT=80

LLM_PROVIDER=openai
LLM_MODEL=gpt-5-nano
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0
RETRIEVAL_K=4
MAX_RETRIES=2

POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=vietnam_real_estate
POSTGRES_USER=app_user

CSV_PATH=/opt/vietnam-real-estate/data/VN-real-estate-Apr-Sept-2025.csv
INGEST_BATCH_SIZE=512
