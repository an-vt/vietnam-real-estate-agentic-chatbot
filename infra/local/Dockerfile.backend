FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY server/ ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 120 . 'debugpy>=1.8,<2'

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
