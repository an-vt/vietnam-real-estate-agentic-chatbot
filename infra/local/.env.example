FRONTEND_PORT=5173
BACKEND_PORT=8000
API_PROXY_TARGET=http://backend:8000
APP_ENV=local
APP_LOG_LEVEL=INFO
OLLAMA_PORT=11435
OLLAMA_BASE_URL=http://localhost:11435
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0
RETRIEVAL_K=4
MAX_RETRIES=2
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# For OpenAI in Compose, use EMBEDDING_PROVIDER=openai and add OPENAI_API_KEY here.
# Its default EMBEDDING_MODEL is text-embedding-3-small.
# Optional descriptions used by the router prompt:
# KB_DESCRIPTION=Vietnamese property listings searchable by meaning.
# SQL_DESCRIPTION=Vietnamese property listings with exact price, area and location fields.
POSTGRES_DB=vietnam_real_estate
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
